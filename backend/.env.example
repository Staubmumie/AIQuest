# Copy to `.env`. api.py loads it automatically on startup.
OPENROUTER_API_KEY=
# Optional: Langfuse tracing (disabled while the keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional, comma-separated
AIQUEST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
